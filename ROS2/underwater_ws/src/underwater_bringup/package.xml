<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>underwater_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configurations for Underwater Hide-and-Seek simulation</description>
  <maintainer email="dev@underwater.sim">Unreal &amp; ROS2 Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>underwater_interfaces</exec_depend>
  <exec_depend>underwater_navigation</exec_depend>
  <exec_depend>underwater_perception</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
