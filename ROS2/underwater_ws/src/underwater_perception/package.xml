<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>underwater_perception</name>
  <version>0.1.0</version>
  <description>Acoustic sonar target filtering and vision detection for Underwater Hide-and-Seek AUVs</description>
  <maintainer email="dev@underwater.sim">Unreal &amp; ROS2 Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>underwater_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
